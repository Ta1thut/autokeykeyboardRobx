<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="AutoKey.App" version="1.0.0.0" processorArchitecture="*"/>
  <description>AutoKey - Auto key presser</description>

  <!-- Visual styles (ปุ่ม/ช่องกรอกหน้าตาแบบ Windows สมัยใหม่) -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls"
                        version="6.0.0.0" processorArchitecture="*"
                        publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>

  <!-- รันด้วยสิทธิ์ผู้ใช้ปกติ (ถ้าเกมรันด้วย Admin ให้คลิกขวา Run as administrator) -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- โปรแกรมปรับขนาด UI ตาม DPI ของจอเอง จึงประกาศเป็น DPI-aware -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
    </windowsSettings>
  </application>
</assembly>
